# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
android/.kotlin/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle may write here when the build directory is redirected.
# The root-anchored /build/ above does not cover these paths.
android/build/
android/app/build/

# Local environment and secrets. These are repeated at the repository root
# because android/.gitignore only covers files under android/.
.env
*.env
key.properties
*.jks
*.keystore

# Build outputs that may be copied outside /build/, such as a distributed APK.
*.apk
*.aab
*.ipa

# Windows metadata
Thumbs.db
desktop.ini

# Widget Preview related
.widget_preview/
